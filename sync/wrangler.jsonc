{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "season-o-meter-sync",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-01",
    "durable_objects": {
        "bindings": [
            { "name": "LISTS", "class_name": "SyncList" },
            { "name": "PAIRING", "class_name": "Pairing" },
        ],
    },
    "migrations": [
        { "tag": "v1", "new_sqlite_classes": ["SyncList"] },
        { "tag": "v2", "new_sqlite_classes": ["Pairing"] },
    ],
    // Pairing requests per IP address. An unused id for this account.
    "ratelimits": [
        {
            "name": "PAIRING_LIMITER",
            "namespace_id": "1001",
            "simple": { "limit": 10, "period": 60 },
        },
    ],
    "vars": {
        // Comma-separated origins that may call the API.
        "ALLOWED_ORIGINS": "https://seasonometer.com,https://www.auner.se",
    },
    "observability": { "enabled": true },
}
